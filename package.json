{
  "name": "wechat-md-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "wechat-md": "dist/cli-convert.js"
  },
  "description": "把 Markdown 渲染成微信公众号可用的全内联样式 HTML：本地编辑器 + Convert API + 草稿推送",
  "keywords": [
    "markdown",
    "wechat",
    "wechat-mp",
    "公众号",
    "排版",
    "inline-style",
    "juice"
  ],
  "license": "MIT",
  "author": "zhaozh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kimizhao/wechat-md-studio.git"
  },
  "homepage": "https://github.com/Kimizhao/wechat-md-studio#readme",
  "bugs": {
    "url": "https://github.com/Kimizhao/wechat-md-studio/issues"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "serve": "node build.mjs && node dist/server.js",
    "check": "node dist/cli-convert.js --check-all",
    "themes": "node dist/cli-convert.js --list-themes",
    "code-themes": "node dist/cli-convert.js --list-code-themes"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@hono/node-server": "^1.19.9",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.10",
    "isomorphic-dompurify": "^4.4.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.0.0",
    "juice": "^12.2.0",
    "marked": "^18.0.14",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
